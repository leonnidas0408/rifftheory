# Copie este arquivo para ".env" e preencha com SEUS valores:
#   cp .env.example .env
#
# ========================================================================
# CHATBOT (IA de teoria musical via Groq)
# ========================================================================
# Chave da API da Groq. Usada somente pela função serverless em /api/chat.js.
# Na Vercel, configure GROQ_API_KEY em Project Settings > Environment Variables.
GROQ_API_KEY=sua_chave_da_api_da_groq_aqui

# Opcional: modelo da Groq usado pelo chatbot
# GROQ_MODEL=llama-3.3-70b-versatile

# ========================================================================
# LOGIN GOOGLE VIA SUPABASE
# ========================================================================
# Front-end (Vite):
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Site Key pública do Cloudflare Turnstile (não é segredo; usada pelo navegador).
# O Secret Key deve ficar somente em Supabase > Edge Functions > Secrets como
# TURNSTILE_SECRET_KEY. Nunca coloque o Secret Key em VITE_ ou no repositório.
VITE_TURNSTILE_SITE_KEY=sua_site_key_publica_do_turnstile

# API serverless do chatbot: use os mesmos valores para validar a sessão.
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sua-chave-anon-publica

# Obrigatória para habilitar GET /api/catalog. UUID do usuário Supabase proprietário.
# CATALOG_OWNER_USER_ID=uuid-do-usuario-proprietario

# Ingestão local do Google Drive:
# DRIVE_FOLDER_ID=id-da-pasta
# DRIVE_MAX_FILE_MB=100
